# Any OpenAI-compatible endpoint works. These defaults use OpenRouter's free tier.
OPENROUTER_API_KEY=sk-or-...
BASE_URL=https://openrouter.ai/api/v1

# Pick a free model that supports tool calling: https://openrouter.ai/models?q=free
# Free models come and go; if this one disappears, swap in another.
MODEL=openai/gpt-oss-20b:free

# Tracing is off for the "black box" run in the article. Turn it on with: make run TRACING=on
TRACING=off
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Only needed for the Langfuse backend (cloud.langfuse.com, free tier).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel

# The fix from the article. Leave at 0 to reproduce the bug.
TOOL_FIX=0
